#!/usr/bin/env bash
# Stage launcher.
#
#   ./jclaw 1        round 1 - switches branch silently, seeds the clipboard, runs
#                    (round 1 follow-ups, typed by hand: "ok, not bad! Let's tweak it
#                     a bit." then "what did I just ask you about?")
#   ./jclaw 2|3|4    same for the other rounds
#   ./jclaw          re-run whatever round is checked out
#   ./jclaw tui      round 4 in the three-pane UI          (round4 only)
#   ./jclaw skills N corporate-speak at intensity N        (round4 only)
#   ./jclaw graph    emit pipeline.mmd from the strategy   (round4 only)
#   ./jclaw codex    typed output from Codex               (round4 only)
#
# Switching is silent on purpose: "Already on 'round1'" on a projector announces
# that the whole thing was staged. Nothing about the mechanics should be on screen.
#
# The round's opening line is copied to the clipboard, so paste it - do not type it
# live and do not misremember it. It is the same sentence in rounds 2-4 by design.
set -euo pipefail
cd "$(dirname "$0")"

# Keys live in .env (gitignored). Never typed, never on screen.
if [ -f .env ]; then set -a; . ./.env; set +a; fi
if [ -z "${GOOGLE_API_KEY:-}" ]; then
  echo "GOOGLE_API_KEY is not set. Put it in .env (see .env.example)." >&2
  exit 1
fi

ASK="Get me out of the Basic AI Proficiency Training on Tuesday, run by Dana from People Ops. Don't reuse an excuse I've already used on her - tell me which ones you're avoiding."

# Every round opens with the SAME sentence. Identical input, four different
# behaviours - that is the comparison, so it must not be retyped slightly differently.
# Round 1's follow-ups ("let's tweak it a bit", then "what did I just ask you about?")
# are typed by hand; the contradiction between those two answers is the beat.
seed() {
  if command -v pbcopy >/dev/null 2>&1; then printf '%s' "$ASK" | pbcopy; fi
}

case "${1:-run}" in
  1|2|3|4)
    git checkout -q "round$1" -- . 2>/dev/null || true
    git checkout -q "round$1" 2>/dev/null || true
    # A round starts from the three committed prior declines: whatever earlier runs
    # wrote into memory/ (and the vector cache) goes. A bare ./jclaw re-run KEEPS it -
    # that continuity across processes is the round 3 beat.
    git clean -fdqx -- memory
    seed
    exec ./jclaw            # re-exec: this file may differ on the branch we just entered
    ;;
esac

# Always rebuild. build/ is gitignored so it survives a checkout - guarding on "does
# the binary exist" would silently launch the PREVIOUS round.
./gradlew -q :app:installDist :mocks:mcpJars >/dev/null 2>&1

case "${1:-run}" in
  tui)    exec app/build/install/app/bin/app-tui ;;
  skills) export JCLAW_LEVEL="${2:-11}"; exec app/build/install/app/bin/app-skills ;;
  graph)  exec app/build/install/app/bin/app-graph ;;
  codex)  exec app/build/install/app/bin/app-codex ;;
  run|*)  exec app/build/install/app/bin/app ;;
esac
