# Copy to `.env` (gitignored). ./jclaw sources it automatically, so no key is
# ever typed at a terminal or visible on a stream.

GOOGLE_API_KEY=AIza...

# Gemini uses the Google key above for chat, tools, memory, and runtime skills.

# Optional - Langfuse traces for rounds 2-4. Unset means the OpenTelemetry feature is
# never installed and the demo runs exactly as normal. Keys: the Langfuse project ->
# Settings -> API Keys. The base URL is the project's region.
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com   # or https://cloud.langfuse.com (EU)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Optional runtime skills root (defaults to skills/ in the repository).
# JCLAW_SKILLS_ROOT=/absolute/path/to/skills
# Standalone ./jclaw skills: optional intensity and supplied source message.
# JCLAW_LEVEL=4
# JCLAW_MESSAGE=Your message to rewrite
