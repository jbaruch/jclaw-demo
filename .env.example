# Copy to `.env` (gitignored). ./jclaw sources it automatically, so no key is
# ever typed at a terminal or visible on a stream.

GOOGLE_API_KEY=AIza...

# Rounds 1-3 and most of round 4 run on the Google key above.
# The optional cross-vendor critic (JCLAW_CRITIC=cli) and the typed-Codex probe
# use your local Claude Code / Codex SUBSCRIPTIONS - no keys needed for those.

# Optional - Langfuse traces for round 4. Unset means the OpenTelemetry feature
# is never installed and the demo runs exactly as normal.
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
